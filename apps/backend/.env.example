# JARV Backend - Environment Configuration Example
# Copy this file to .env and update with your values

# Application
PROJECT_NAME="JARV Agentic AI System"
VERSION="1.0.0"
ENVIRONMENT=development  # development, staging, production
DEBUG=false
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
HOT_RELOAD=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database
POSTGRES_USER=jarv
POSTGRES_PASSWORD=jarv_password
POSTGRES_DB=jarv
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jarv:jarv_password@localhost:5432/jarv
DATABASE_POOL_SIZE=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Security (REQUIRED - Generate strong keys for production!)
SECRET_KEY=your-secret-key-min-32-characters-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_TIMEOUT_MINUTES=60

# CORS
CORS_ENABLED=true

# AI Provider API Keys (will be used in Phase 4)
CLAUDE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Memory embeddings: auto uses OpenAI when OPENAI_API_KEY is set, otherwise the
# built-in offline embedder. Dimensions must stay 1536.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Mission runtime: celery (worker queue, default) | background (no worker
# container; runs in the API process) | sync. Missions whose worker stops
# heartbeating for MISSION_STALE_SECONDS are re-queued automatically.
MISSION_EXECUTION_MODE=celery
MISSION_STALE_SECONDS=120

# Observability: when set, /metrics needs "Authorization: Bearer <METRICS_TOKEN>"
# and the Alertmanager webhook needs ALERT_WEBHOOK_TOKEN. Put the same values in
# infra/monitoring/secrets/ and enable them in prometheus.yml / alertmanager.yml.
METRICS_TOKEN=
ALERT_WEBHOOK_TOKEN=

# Operations (Repair 12d). The compose files set DOCKER_OPS_URL (restricted
# Docker proxy) and BACKUP_DIR for backend and worker; PROMETHEUS_URL is set by
# docker-compose.monitoring.yml. Backups run every BACKUP_INTERVAL_HOURS.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# Deployments to your VPS (Repair 12e-2). See docs/DEPLOYMENT.md.
DEPLOY_SSH_HOST=
DEPLOY_SSH_USER=deploy
DEPLOY_SSH_PORT=22
DEPLOY_SSH_PRIVATE_KEY=
DEPLOY_SSH_KNOWN_HOSTS=
DEPLOY_BASE_DIR=/srv/jarv

# Feature Flags
SWARM_ENABLED=true
SELF_EVOLUTION_ENABLED=true
COMPANY_OPERATOR_ENABLED=true
SELF_HEALING_ENABLED=true
VOICE_ENABLED=false

# Optional private Voicebox integration (Docker service name or trusted local URL)
VOICEBOX_BASE_URL=http://voicebox:17493
VOICEBOX_PROFILE_ID=
VOICEBOX_CONNECT_TIMEOUT_SECONDS=3
VOICEBOX_READ_TIMEOUT_SECONDS=180
VOICEBOX_MAX_AUDIO_BYTES=26214400
WAKEWORD_MODEL_DIR=/data/voice-models/sherpa-kws-gigaspeech

# Authority and Limits
DEFAULT_AUTHORITY_LEVEL=3
MAX_SUBAGENTS_PER_WORKSPACE=50
MAX_SUBAGENTS_GLOBAL=500
SUBAGENT_SPAWN_COOLDOWN_SECONDS=1

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Monitoring
SENTRY_DSN=
ENABLE_METRICS=false

# Infrastructure money (Repair 12e-4b). Fixed monthly costs as JSON, the approved monthly
# budget, the cost of one extra replica per month, and the replica ceiling. Scaling beyond
# the budget or the ceiling pauses for Richard.
INFRA_FIXED_COSTS={"vps": 0}
INFRA_MONTHLY_BUDGET=0
INFRA_REPLICA_MONTHLY_COST=0
INFRA_MAX_REPLICAS=5

# Revenue and analytics (read-only, Repair 12e-4b). Unset = disabled; JARV uses recorded revenue.
# STRIPE_SECRET_KEY: a restricted read-only key. STRIPE_WEBHOOK_SECRET: the signing secret of the
# webhook endpoint /api/revenue/<workspace id>/stripe-webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=
PLAUSIBLE_URL=https://plausible.io
APP_STORE_COUNTRY=us
